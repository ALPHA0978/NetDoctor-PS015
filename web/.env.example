# Machine running the Python collector. Keep loopback for a same-PC browser.
NEXT_PUBLIC_NETDOCTOR_API=http://127.0.0.1:8765
# Optional Firebase syncing, off until enabled in the dashboard. Set up Firebase
# Authentication (Anonymous) and install the supplied Firestore ownership rules first.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
